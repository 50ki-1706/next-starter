{
  "description": "Require Codex shell commands to execute through Devbox.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "devbox run -- sh -c 'node \"$(git rev-parse --show-toplevel)/.codex/hooks/require-devbox.mjs\"'",
            "timeout": 30,
            "statusMessage": "Checking Devbox command policy"
          }
        ]
      }
    ]
  }
}
